# Copy to .env and fill in. The backend reads this file from the project root.

# --- Required: model + retrieval ---------------------------------------------
OPENROUTER_API_KEY=your-openrouter-key
EXA_API_KEY=your-exa-key                  # web-search fallback
LANGCHAIN_API_KEY=your-langsmith-key      # optional tracing

# --- Required: auth -----------------------------------------------------------
# The app refuses to start without this. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# For local development only, you may instead set ALLOW_EPHEMERAL_SECRET=1 to
# generate a throwaway key at startup (all tokens are invalidated on restart).
# ALLOW_EPHEMERAL_SECRET=1

# How long an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- First-run admin bootstrap ------------------------------------------------
# /register_admin only works while NO manager account exists, and only when the
# caller supplies this token. Afterwards, managers create accounts via
# POST /admin/users. Leave unset to disable admin bootstrap entirely.
ADMIN_SETUP_TOKEN=

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# --- Uploads ------------------------------------------------------------------
MAX_UPLOAD_MB=50

# --- Database -----------------------------------------------------------------
# Defaults to sqlite:///./users.db. Point at Postgres for multi-process
# deployments (SQLite will not survive concurrent workers).
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/valar
