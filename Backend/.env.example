# -------------------------
# Valar Backend Configurations Template
# -------------------------

# LLM and Vector Embeddings API Access Key (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Live Web Search Fallback API Key (Exa Search)
EXA_API_KEY=your_exa_api_key_here

# JWT Signature Verification Secret Key (Replace with a strong random string in production)
SECRET_KEY=supersecretkey_replace_in_prod

# Persistent Data Storage Locations
# Point these at a mounted persistent volume (e.g. Railway volume at /data).
# Leaving them unset stores everything on the container's own disk, which is
# wiped on every redeploy — while an external Neo4j graph survives, so the
# document list and the knowledge graph silently drift apart.
#
# NOTE: the database is configured by DATABASE_URL (a full SQLAlchemy URL),
# not a bare path. Use four slashes for an absolute path.
DATABASE_URL=sqlite:////data/users.db
CHROMA_DB_PATH=/data/chroma_db
UPLOAD_DIRECTORY=/data/uploaded_files
SETTINGS_PATH=/data/settings.json
ACTIVITY_LOG_PATH=/data/activity_logs.json

# CORS Origin Locking
# Specify a comma-separated list of allowed client origin URLs (your deployed Vercel domain)
ALLOWED_ORIGINS=https://your-vercel-deployment.vercel.app,http://localhost:3000

# Audio Transcription API Key (Groq Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Lyzr Studio (https://studio.lyzr.ai) — independent verifier that audits a
# Graph RAG answer against the graph evidence. Unset = feature reports itself
# as not configured in the UI and stays disabled; nothing else breaks.
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_USER_ID=your_lyzr_account_email

# Knowledge-graph extraction concurrency. Free-tier LLMs throttle under
# parallel load and silently fall back to low-quality heuristic extraction.
GRAPH_EXTRACTION_WORKERS=2
